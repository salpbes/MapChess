{
  "name": "mapchess",
  "private": true,
  "version": "0.0.1",
  "description": "Chess on a 3D board carved from real-world terrain.",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-engine.mjs",
    "predev": "node scripts/copy-engine.mjs",
    "prebuild": "node scripts/copy-engine.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "play": "tsx scripts/play.ts",
    "make-fixtures": "npm run make-fixtures:elevation && npm run make-fixtures:features",
    "make-fixtures:elevation": "tsx scripts/make-fixtures.ts",
    "make-fixtures:features": "tsx scripts/make-feature-fixtures.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "pieces": "node scripts/compress-pieces.mjs"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "maplibre-gl": "^6.7.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@playwright/test": "^1.63.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.4.1",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.185.4",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "ktx2-encoder": "^0.6.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "stockfish": "^18.0.8",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
